      "wide": "1920px"
    }
  },
  "rendering_instructions": {
    "resolution": "7680x4320 minimum (8K)",
    "style": "photorealistic SaaS UI screenshot \u2014 Figma quality",
    "font_rendering": "crisp subpixel antialiasing \u2014 zero blur on text",
    "color_accuracy": "exact hex match sRGB",
    "depth_of_field": "none \u2014 all elements at equal sharp focus",
    "background": "pure white or #FAFAF8 as specified per screen",
    "no_blur": true,
    "negative": "blur, glow, neon, gradients on text, dark mode entire screen, mobile layout, sketch, watercolor, 3D render, cartoon, lens flare, oversaturation, illegible text, missing UI elements, cropped content"
  }
