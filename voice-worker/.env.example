# ==========================================
# LIVEKIT CLOUD CREDENTIALS
# ==========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ==========================================
# AI MODEL KEYS
# ==========================================
GROQ_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp

# Optional
OPENAI_API_KEY=

# ==========================================
# LLM SETTINGS
# ==========================================
LLM_PROVIDER=groq
# llama-3.1-8b-instant = lowest latency (recommended for voice)
# llama-3.3-70b-versatile = better quality, higher latency
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7

# ==========================================
# TTS SETTINGS
# ==========================================
TTS_PROVIDER=sarvam
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=en-IN
SARVAM_MODEL=bulbul:v2

# ==========================================
# STT SETTINGS
# ==========================================
# "multi" = auto-detect any language (recommended)
STT_LANGUAGE=multi

# ==========================================
# VOICELINK SIP TRUNK
# ==========================================
VOICELINK_SIP_DOMAIN=
VOICELINK_SIP_USERNAME=
VOICELINK_SIP_PASSWORD=
VOICELINK_SIP_OUTBOUND_NUMBER=
VOICELINK_SIP_TRUNK_ID=
VOICELINK_SIP_TECH_PREFIX=45454
DEFAULT_TRANSFER_NUMBER=

# ==========================================
# WEBHOOK — CRITICAL FOR PRODUCTION
# Set this to your deployed Next.js URL + /api/voice/transcript
# Example: https://your-app.vercel.app/api/voice/transcript
# ==========================================
WEBHOOK_URL=https://your-app.vercel.app/api/voice/transcript

# ==========================================
# SUPABASE (for BYOK dynamic config)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# MISC
# ==========================================
ENABLE_NOISE_CANCELLATION=false
PORT=8080
