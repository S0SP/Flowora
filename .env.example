# ============================================================
# FLOWORA — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WhatsApp / Meta (defaults; per-workspace from DB via channel_connections) ─
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=

# ── AI ───────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
EMBEDDING_API_KEY=

# ── LiveKit / Voice ──────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dograh backend used for outbound AI voice calls.
# In Vercel, DOGRAH_API_URL should be your current ngrok HTTPS URL while
# Dograh runs locally. DOGRAH_SECRET must match Dograh's FLOWRA_SECRET.
DOGRAH_API_URL=http://localhost:8000
DOGRAH_SECRET=change-me-in-production
DOGRAH_WORKFLOW_ID=1

# ── Railway Voice Worker ─────────────────────────────────
RAILWAY_VOICE_WORKER_URL=
VOICE_WORKER_SECRET=

# ── Billing ──────────────────────────────────────────────
# Stripe (primary billing — for international)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_CREDIT_1000=
STRIPE_PRICE_CREDIT_5000=
# Razorpay (alternative for INR billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Secret encryption (for BYOK creds stored in DB) ──────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Redis (Upstash — rate limiting, hot cache, presence) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── QStash (Upstash — durable job queue) ─────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Google OAuth (for integrations, Sheets trigger) ──────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Legacy Vapi (optional, alternate voice path) ─────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
