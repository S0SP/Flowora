{
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/poll-sheets",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/process-schedules",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/lead-capture",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" }
      ]
    }
  ]
}
